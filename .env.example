# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kampala:kampala@localhost:5432/kampalasmart?schema=public
TEST_DATABASE_URL=postgresql://kampala:kampala@localhost:5432/kampalasmart_test?schema=public

# ── Redis (rate limiting / health). Optional: API falls back to in-memory. ─
REDIS_URL=redis://localhost:6379

# ── Authentication (generate with: openssl rand -hex 32) ──────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Email (development-outbox by default; no external email is sent) ─────
EMAIL_PROVIDER=development-outbox

# ── Rate limiting ─────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=900

# ── Deployment ────────────────────────────────────────────────────────────
TRUST_PROXY=0
LOG_LEVEL=info

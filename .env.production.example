# Production compose stack. Copy to .env.production and fill every value.
# Never commit the filled file.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=kampala
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
POSTGRES_DB=kampalasmart

# Use the service name, not localhost. URL-encode special characters in the password.
DATABASE_URL=postgresql://kampala:replace-with-a-long-alphanumeric-password@postgres:5432/kampalasmart?schema=public

# ── Redis (shared rate limiting) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Authentication ────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set true behind HTTPS. The reference stack exposes the web port over HTTP;
# terminate TLS in a reverse proxy and keep this true in real deployments.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ── Browser origin and internal proxy ────────────────────────────────────
# Must match the public scheme/host exactly, including https.
WEB_ORIGIN=https://pos.example.com
API_INTERNAL_URL=http://api:4000

# ── Email (development-outbox only; nothing is delivered externally) ─────
EMAIL_PROVIDER=development-outbox

# ── Rate limiting ────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=900

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=1
WEB_PORT=3000
